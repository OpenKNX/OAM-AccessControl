<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns="http://knx.org/xml/project/20" xmlns:op="http://github.com/OpenKNX/OpenKNXproducer">

  <op:config href="AccessControl.conf.xml" />
  <op:config name="%IsSecureEnabled%" value="false" />
  <op:config name="%SWA_Measure%" value="0" />
  <op:config name="%NET_ServiceHTTP%" value="1" />
  <op:config name="%NET_ServiceNTP%" value="0" />
  <op:config name="%NET_ServiceOTA%" value="0" />
  <op:config name="%NET_WifiTool%" value="1" />

  <op:nowarn id="1" regex="ACC_ApplicationVersion" />
  <!-- These helpers are called by script handlers or retained for older ETS button bindings. -->
  <op:nowarn id="3" regex="HK_(setOnlineStatus|call|requireOk|wait|status|statusText|run|hex|readEndpoints|importEndpoints|authorizationFields|deleteAuthorization([0-9]{2})?|nfcAssignmentInfo)\b" />
  <op:nowarn id="3" regex="NFCUI_(parameter|value|status|rows|validate|input|uidWrite|selected|identity|search)\b" />
  <op:nowarn id="3" regex="ACC_(enrollNfc|changeNfc|deleteNfc|resetNfcScanner)\b" />
  <!-- The producer also detects anonymous JavaScript callbacks as an empty function name. -->
  <op:nowarn id="3" regex="Function with name  was never called from xml" />

  <op:ETS OpenKnxId="0xA6"
    ApplicationNumber="0x01"
    ApplicationVersion="11.7.0"
    ReplacesVersionsDownTo="4.0"
    ApplicationRevision="0"
    ProductName="Zutrittskontrolle"
    BuildSuffix="-Dev"
    BuildSuffixText=" (Dev)"
    OrderNumber="OpenKnxAccessControl"
    BaggagesRootDir="A6/01"
    MediumTypes="MT-0 MT-5"
    MaskVersion="MV-07B0"
  />

  <op:define prefix="BASE" ModuleType="1"
            share="../lib/OGM-Common/src/Common.share.xml">
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="%BASE_VerifyVersion%" />
  </op:define>

  <op:define prefix="UCT"
    share="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml"
    noConfigTransfer="true"
    ModuleType="99">
    <op:verify File="../lib/OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>


  <!-- for FIN, we have to stay with ModuleType 2!!! -->
  <op:define prefix="ACC"
    configTransferName="Zutrittskontrolle (Aktionen + Allgemein)"
    share="../lib/OFM-AccessControl/src/AccessControl.share.xml"
    template="../lib/OFM-AccessControl/src/Action.templ.xml"
    ModuleType="2"
    KoSingleOffset="20"
    KoOffset="500"
    NumChannels="150">
    <op:verify File="../lib/OFM-AccessControl/library.json" ModuleVersion="%ACC_VerifyVersion%" />
  </op:define>

    <op:define prefix="FINACT"
    prefixDoc="ACC"
    configTransferName="    - (Finger)"
    share="../lib/OFM-AccessControl/src/FingerAction.share.xml"
    template="../lib/OFM-AccessControl/src/FingerAction.templ.xml"
    ModuleType="2"
    NumChannels="300" />

    <op:define prefix="FINACTSER"
    noConfigTransfer="true"
    prefixDoc="ACC"
    template="../lib/OFM-AccessControl/src/FingerActionSearch.templ.xml"
    ModuleType="2"
    NumChannels="7" />

    <op:define prefix="NFCACT"
    prefixDoc="ACC"
    configTransferName="    - (NFC)"
    share="../lib/OFM-AccessControl/src/NfcAction.share.xml"
    template="../lib/OFM-AccessControl/src/NfcAction.templ.xml"
    ModuleType="2"
    NumChannels="310" />

    <op:define prefix="NFCACTSER"
    noConfigTransfer="true"
    prefixDoc="ACC"
    template="../lib/OFM-AccessControl/src/NfcActionSearch.templ.xml"
    ModuleType="2"
    NumChannels="7" />

    <op:define prefix="KEYACT"
    prefixDoc="ACC"
    configTransferName="    - (Keypad)"
    share="../lib/OFM-AccessControl/src/KeypadAction.share.xml"
    template="../lib/OFM-AccessControl/src/KeypadAction.templ.xml"
    ModuleType="2"
    NumChannels="320" />

    <op:define prefix="KEYACTSER"
    noConfigTransfer="true"
    prefixDoc="ACC"
    template="../lib/OFM-AccessControl/src/KeypadActionSearch.templ.xml"
    ModuleType="2"
    NumChannels="7" />

    <op:define prefix="SWA"
    share="../lib/OFM-SwitchActuator/src/SwitchActuatorModule.share.xml"
    template="../lib/OFM-SwitchActuator/src/SwitchActuatorModule.templ.xml"
    NumChannels="1"
    KoSingleOffset="8"
    KoOffset="91"
    ModuleType="4">
    <op:verify File="../lib/OFM-SwitchActuator/library.json" ModuleVersion="%SWA_VerifyVersion%" />
    </op:define>

  <op:define prefix="LOG"
    share="../lib/OFM-LogicModule/src/Logikmodul.share.xml"
    template="../lib/OFM-LogicModule/src/Logikmodul.templ.xml"
    NumChannels="3"
    KoOffset="100"
    ModuleType="1">
    <op:verify File="../lib/OFM-LogicModule/library.json" ModuleVersion="%LOG_VerifyVersion%" />
    </op:define>

    <op:define prefix="BTN"
    share="../lib/OFM-VirtualButton/src/VirtualButton.share.xml"
    template="../lib/OFM-VirtualButton/src/VirtualButton.templ.xml"
    NumChannels="8"
    KoOffset="400"
    ModuleType="3">
    <op:verify File="../lib/OFM-VirtualButton/library.json" ModuleVersion="%BTN_VerifyVersion%" />
    </op:define>

    <op:define prefix="BI"
    share="../lib/OFM-BinaryInput/src/BinaryInputChannel.share.xml"
    template="../lib/OFM-BinaryInput/src/BinaryInputChannel.templ.xml"
    NumChannels="4"
    KoOffset="86"
    ModuleType="5">
    <op:verify File="../lib/OFM-BinaryInput/library.json" ModuleVersion="%BI_VerifyVersion%" />
    </op:define>

  <!-- 
  6 KOs 
  => 6 KOs
  => [80,86[
  -->
  <op:define prefix="BUZZ"
    share="../lib/OFM-Feedback/src/Feedback.share.xml"
    KoSingleOffset="80"
    ModuleType="6">
    <op:verify File="../lib/OFM-Feedback/library.json" ModuleVersion="%BUZZ_VerifyVersion%" />
  </op:define>

  <op:define prefix="HK" ModuleType="7"
    share="../lib/OFM-HomeKey/src/HomeKey.share.xml" KoSingleOffset="300">
    <op:verify File="../lib/OFM-HomeKey/library.json" ModuleVersion="0.4" />
  </op:define>

  <op:define prefix="NET" ModuleType="8"
    share="../lib/OFM-Network/src/Network.share.xml">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="0.8" />
  </op:define>

  <op:define prefix="NFCUI" ModuleType="90" noConfigTransfer="true" share="NfcManagement.share.xml" />

    <generate base="SecureApplication.xml">
      <Dynamic>
        <op:include href="../lib/OGM-Common/src/Common.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BASE" />
        <op:include href="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="UCT" />
        <Channel Id="%AID%_CH-ACC" Name="BasicChannel" Number="ACC" Text="Zutrittskontrolle" Icon="shield-lock-outline" HelpContext="ACC-Dokumentation">
          <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline" HelpContext="ACC-Dokumentation" ShowInComObjectTree="true">
            <op:include href="../lib/OFM-AccessControl/src/AccessControl.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/ParameterBlock[@Name='Basic']/*[not(contains(@ParamRefId, '000034'))]" prefix="ACC" />
            <choose ParamRefId="%AID%_UP-2000034_R-200003401"><when test="!=0">
              <op:include href="NfcManagement.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NFCUI" />
            </when></choose>
          </ParameterBlock>
          <op:include href="../lib/OFM-AccessControl/src/AccessControl.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/*[not(@Name='Basic')]" prefix="ACC" />
          <choose ParamRefId="%AID%_UP-2000034_R-200003401">
            <when test="!=0">
              <op:include href="../lib/OFM-HomeKey/src/HomeKey.share.xml" xpath="//ApplicationProgram/Dynamic/Channel/*" prefix="HK" />
            </when>
          </choose>
        </Channel>
        <op:include href="../lib/OFM-Network/src/Network.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="NET" />
        <op:include href="../lib/OFM-SwitchActuator/src/SwitchActuatorModule.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="SWA" />
        <op:include href="../lib/OFM-LogicModule/src/Logikmodul.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="LOG" />
        <op:include href="../lib/OFM-VirtualButton/src/VirtualButton.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BTN" />
        <op:include href="../lib/OFM-BinaryInput/src/BinaryInputChannel.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BI" />
        <op:include href="../lib/OFM-Feedback/src/Feedback.share.xml" xpath="//ApplicationProgram/Dynamic/*" prefix="BUZZ" />
      </Dynamic>
    </generate>
</KNX>
